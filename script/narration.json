   },
   "lines": [
    {
     "id": "s02_title.1",
     "text": "包括你现在看到的这一帧。",
     "gapAfter": 0.12,
     "rate": "-8%"
    },
    {
     "id": "s02_title.2",
     "text": "用 Opus 5.5 做的视频，为什么这么炫？小白怎么做？一次讲明白。"
    }
   ]
  },
  {
   "id": "s03_text",
   "chapter": "c1",
   "theme": "dark",
   "transition": {
    "type": "wipe",
